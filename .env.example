#--------------------------------------------------------------------
# CustomCart — CodeIgniter 4 website and sitepanel
#
# Copy this file to .env (same folder) and fill in real values.
# .env is git-ignored and must never be committed; the project's root
# .htaccess keeps it out of the web server's reach.
#--------------------------------------------------------------------

# development | testing | production (unset = production: errors never shown)
CI_ENVIRONMENT = production

# Full URL of the application, with a trailing slash. Production: the real
# domain, https when available, plus the sub-folder if the app is not at the
# domain root (https://www.example.com/ or https://www.example.com/customcart/).
# In production a missing or localhost baseURL stops the app with an error.
# Under WAMP without a virtual host: http://localhost/customcart/
# Under `php spark serve` (development) the address the browser uses is
# followed automatically (any port); this value is still used by CLI commands.
app.baseURL = 'https://www.example.com/'

#--------------------------------------------------------------------
# DATABASE (the customcart schema)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = customcart
database.default.username =
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# COOKIES
# Use cookie names unique to this site, so another application on the same
# host cannot overwrite its session and CSRF cookies.
#--------------------------------------------------------------------
session.cookieName = customcart_ci4_session
security.cookieName = csrf_customcart_ci4_cookie
# Set to true once the site is served over HTTPS.
cookie.secure = false

#--------------------------------------------------------------------
# PUBLIC WEBSITE
# Public website opened by the sitepanel's "View Website" / "Back to website"
# links. Empty = app.baseURL.
#--------------------------------------------------------------------
app.websiteURL = ''

#--------------------------------------------------------------------
# OUTGOING EMAIL (app/Libraries/Mailer.php)
#   One method sends every email of the site (no fallback to another one):
#   mail      PHP mail() (default, also when empty). Windows: relays to SMTP / smtp_port in php.ini
#   smtp      the SMTP server below (smtpCrypto tls = STARTTLS, usually port 587;
#             ssl = port 465; empty = none). Leave user and password empty for no login.
#   api       an emailer API: apiProvider sendgrid with its apiKey (apiUrl empty =
#             https://api.sendgrid.com/v3/mail/send; the sender address must be
#             verified in SendGrid)
#   ci_email  CodeIgniter's Email service with app/Config/Email.php
#--------------------------------------------------------------------
mail.method = mail
mail.smtpHost =
mail.smtpPort = 587
mail.smtpCrypto = tls
mail.smtpUser =
mail.smtpPass =
mail.smtpTimeout = 10
mail.apiProvider = sendgrid
mail.apiKey =
mail.apiUrl =
mail.apiTimeout = 15
# TEMPORARY (local / staging only): true shows the success message even when
# sending fails; the real failure is still logged. Keep false on production.
mail.showSuccessOnFailure = false
